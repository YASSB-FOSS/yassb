{
  "name": "yassb-web",
  "version": "2.0.0",
  "description": "YASSB (Yet Another Static Site Builder) processes HTML, (S)CSS, JavaScript/TypeScript, JSX/TSX, JSON, MarkDown and many other files and combines them into beautiful static websites",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "default": "./dist/tools.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "yassb": "./bin.js"
  },
  "files": [
    "bin.js",
    "dist",
    "docs",
    "templates",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "bun scripts/check-features.ts && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "bun run build && bun test",
    "prepack": "bun run build",
    "landing:build": "cd landing && node ../bin.js build",
    "landing:watch": "cd landing && node ../bin.js watch",
    "deploy": "cglg --action=newRelease && bun run build && cglg --action=closeRelease && npm publish",
    "deploy-landing": "bun run build && bun run landing:build && cd landing/YASSB-FOSS.github.io && npm run deploy",
    "features": "bun scripts/check-features.ts"
  },
  "homepage": "https://yassb-foss.github.io/",
  "repository": {
    "type": "git",
    "url": "https://github.com/YASSB-FOSS/yassb.git"
  },
  "keywords": [
    "static website",
    "html",
    "static",
    "website",
    "website builder",
    "website generator",
    "serverless"
  ],
  "dependencies": {
    "esbuild": "^0.28.2",
    "gray-matter": "^4.0.3",
    "html-minifier-terser": "^7.2.0",
    "sass": "^1.106.0",
    "showdown": "^2.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2"
  },
  "author": "ilDon",
  "license": "MIT"
}
