{
  "name": "yassb-web",
  "version": "2.0.0",
  "description": "Static site builder: HTML components, JSON data, Markdown and i18n, with TypeScript renderers. Fast (esbuild), five dependencies, and a CLI coding agents use to inspect and check a site.",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "default": "./dist/tools.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "yassb": "./bin.js"
  },
  "files": [
    "bin.js",
    "dist",
    "docs",
    "templates",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "bun scripts/check-features.ts && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "bun run build && bun test",
    "prepack": "bun run build",
    "landing:build": "cd landing && node ../bin.js build",
    "landing:watch": "cd landing && node ../bin.js watch",
    "deploy": "cglg --action=newRelease && bun run build && cglg --action=closeRelease && npm publish",
    "deploy-landing": "bun scripts/deploy-landing.ts",
    "features": "bun scripts/check-features.ts"
  },
  "homepage": "https://yassb-foss.github.io/",
  "repository": {
    "type": "git",
    "url": "https://github.com/YASSB-FOSS/yassb.git"
  },
  "keywords": [
    "static site generator",
    "static site builder",
    "static website",
    "website builder",
    "html",
    "components",
    "markdown",
    "i18n",
    "typescript",
    "esbuild",
    "bun",
    "cli",
    "ai agents",
    "agentic coding"
  ],
  "dependencies": {
    "esbuild": "^0.28.2",
    "gray-matter": "^4.0.3",
    "html-minifier-terser": "^7.2.0",
    "sass": "^1.106.0",
    "showdown": "^2.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2"
  },
  "author": "ilDon",
  "license": "MIT"
}
